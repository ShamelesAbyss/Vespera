<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Vespera" Manufacturer="Vespera" Version="$(Version)"
           UpgradeCode="81BA1438-9EAE-4707-AB97-66D09CAD81DD" Scope="perUser">
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of Vespera is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="vespera.ico" SourceFile="$(Stage)\assets\branding\vespera.ico" />
    <Property Id="ARPPRODUCTICON" Value="vespera.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Vespera">
          <Directory Id="BinFolder" Name="bin" />
          <Directory Id="LicenseFolder" Name="licenses" />
          <Directory Id="AssetFolder" Name="assets">
            <Directory Id="BrandingFolder" Name="branding" />
            <Directory Id="WorldArtFolder" Name="world">
              <Directory Id="WorldArtSpaceBaseFolder" Name="space-base" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Application" Title="Vespera">
      <Component Directory="BinFolder">
        <File Id="Launcher" Source="$(Stage)\bin\vespera-launcher.exe" />
      </Component>
      <Component Directory="BinFolder">
        <File Source="$(Stage)\bin\vespera-view.exe" />
      </Component>
      <Component Directory="BinFolder">
        <File Source="$(Stage)\bin\vespera.exe" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Source="$(Stage)\LICENSE" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Source="$(Stage)\THIRD_PARTY_NOTICES.md" />
      </Component>
      <Component Directory="LicenseFolder">
        <File Source="$(Stage)\licenses\FiraMono-LICENSE.txt" />
      </Component>
      <Component Directory="LicenseFolder">
        <File Source="$(Stage)\licenses\windows-x64-cargo-inventory.txt" />
      </Component>
      <Component Directory="BrandingFolder">
        <File Source="$(Stage)\assets\branding\vespera-original.jpg" />
      </Component>
      <Component Directory="BrandingFolder">
        <File Source="$(Stage)\assets\branding\vespera.png" />
      </Component>
      <Component Directory="BrandingFolder">
        <File Source="$(Stage)\assets\branding\vespera.ico" />
      </Component>
      <Component Directory="BrandingFolder">
        <File Source="$(Stage)\assets\branding\vespera.icns" />
      </Component>
      <Component Directory="WorldArtFolder">
        <File Source="$(Stage)\assets\world\ATTRIBUTION.md" />
      </Component>
      <Component Directory="WorldArtSpaceBaseFolder">
        <File Source="$(Stage)\assets\world\space-base\LICENSE.txt" />
      </Component>
      <Component Directory="INSTALLFOLDER" Guid="B035E275-8657-4F30-A6F1-09A4C4BB76F4">
        <Shortcut Id="VesperaStart" Directory="ProgramMenuFolder" Name="Vespera"
                  Target="[#Launcher]" WorkingDirectory="BinFolder" Icon="vespera.ico" />
        <Shortcut Id="VesperaDesktop" Directory="DesktopFolder" Name="Vespera"
                  Target="[#Launcher]" WorkingDirectory="BinFolder" Icon="vespera.ico" />
        <RegistryValue Root="HKCU" Key="Software\Vespera\Installer" Name="Shortcuts"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
